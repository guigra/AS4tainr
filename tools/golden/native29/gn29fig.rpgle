**FREE
// Figurative constants and varying fields, and numeric comparisons with
// *HIVAL and *LOVAL, for an upstream fix.
ctl-opt dftactgrp(*no);
dcl-s v varchar(5) inz('XY');
dcl-s w varchar(5) inz(*blanks);
dcl-s y varchar(5) inz(*zeros);
dcl-s p packed(5:2) inz(123.45);
dcl-s z zoned(3:0) inz(7);
dcl-s i int(10) inz(5);
say('VAR INZ BLANKS [' + w + '] ' + %char(%len(w)));
say('VAR INZ ZEROS [' + y + '] ' + %char(%len(y)));
v = *blanks;
say('VAR BLANKS [' + v + '] ' + %char(%len(v)));
v = 'XY';
v = *zeros;
say('VAR ZEROS [' + v + '] ' + %char(%len(v)));
v = 'XY';
v = *all'ab';
say('VAR ALL [' + v + '] ' + %char(%len(v)));
v = 'XY';
v = *hival;
say('VAR HIVAL LEN ' + %char(%len(v)));
z = *hival;
if z = *hival;
  say('ZONED EQ HIVAL YES');
else;
  say('ZONED EQ HIVAL NO');
endif;
if z < *hival;
  say('ZONED LT HIVAL YES');
else;
  say('ZONED LT HIVAL NO');
endif;
p = *loval;
if p = *loval;
  say('PACKED EQ LOVAL YES');
else;
  say('PACKED EQ LOVAL NO');
endif;
p = 999.99;
if p = *hival;
  say('PACKED 999.99 EQ HIVAL YES');
else;
  say('PACKED 999.99 EQ HIVAL NO');
endif;
p = 999.98;
if p < *hival;
  say('PACKED 999.98 LT HIVAL YES');
else;
  say('PACKED 999.98 LT HIVAL NO');
endif;
if i < *hival;
  say('INT LT HIVAL YES');
else;
  say('INT LT HIVAL NO');
endif;
i = *hival;
say('INT HIVAL ' + %char(i));
if i = *hival;
  say('INT EQ HIVAL YES');
else;
  say('INT EQ HIVAL NO');
endif;
v = 'XY';
clear v;
say('VAR CLEAR [' + v + '] ' + %char(%len(v)));
v = 'XY';
reset v;
say('VAR RESET [' + v + '] ' + %char(%len(v)));
*inlr = *on;
// Write one line to gn1.out in the job's current directory (DSPLY under
// `system` goes to QSYSOPR, a queue PUB400 users share).
dcl-proc say;
  dcl-pi *n;
    text varchar(200) const;
  end-pi;
  dcl-s line varchar(200);
  line = text;
  exec sql call qsys2.ifs_write_utf8(path_name => 'gn1.out', line => :line,
                                     overwrite => 'APPEND', end_of_line => 'LF');
end-proc;
