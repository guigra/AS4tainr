**FREE
// Interpreter fix (fork branch fix/quotient-compare): the decimal places
// a quotient keeps in a comparison. 10 / 3 and 2 / 3 against literals of
// 28 to 31 decimal places, equal and greater; 2 / 3 against 40 to 62
// places. Captured on PUB400
// (tools/golden/native214.txt n214_cmpquot).
ctl-opt dftactgrp(*no);
dcl-s line varchar(300);

line = '';
if 10 / 3 = 3.3333333333333333333333333333;
  line += 'e28 ';
endif;
if 10 / 3 = 3.33333333333333333333333333333;
  line += 'e29 ';
endif;
if 10 / 3 = 3.333333333333333333333333333333;
  line += 'e30 ';
endif;
if 10 / 3 > 3.3333333333333333333333333333;
  line += 'g28 ';
endif;
if 10 / 3 > 3.33333333333333333333333333333;
  line += 'g29 ';
endif;
if 10 / 3 > 3.333333333333333333333333333333;
  line += 'g30 ';
endif;
if 10 / 3 < 3.3333333333333333333333333334;
  line += 'l28 ';
endif;
if 2 / 3 = 0.6666666666666666666666666667;
  line += 'h28 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666;
  line += 't28 ';
endif;
if 2 / 3 = 0.66666666666666666666666666667;
  line += 'h29 ';
endif;
if 2 / 3 = 0.66666666666666666666666666666;
  line += 't29 ';
endif;
if 2 / 3 > 0.6666666666666666666666666666666;
  line += 'g31 ';
endif;
if 2 / 3 > 0.6666666666666666666666666666666666666666;
  line += 'G40 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666666;
  line += 'T40 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666667;
  line += 'H40 ';
endif;
if 2 / 3 > 0.66666666666666666666666666666666666666666666666666;
  line += 'G50 ';
endif;
if 2 / 3 = 0.66666666666666666666666666666666666666666666666666;
  line += 'T50 ';
endif;
if 2 / 3 = 0.66666666666666666666666666666666666666666666666667;
  line += 'H50 ';
endif;
if 2 / 3 > 0.6666666666666666666666666666666666666666666666666666666666;
  line += 'G58 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666666666666666666666666;
  line += 'T58 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666666666666666666666667;
  line += 'H58 ';
endif;
if 2 / 3 > 0.666666666666666666666666666666666666666666666666666666666666;
  line += 'G60 ';
endif;
if 2 / 3 = 0.666666666666666666666666666666666666666666666666666666666666;
  line += 'T60 ';
endif;
if 2 / 3 = 0.666666666666666666666666666666666666666666666666666666666667;
  line += 'H60 ';
endif;
if 2 / 3 > 0.6666666666666666666666666666666666666666666666666666666666666;
  line += 'G61 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666666666666666666666666666;
  line += 'T61 ';
endif;
if 2 / 3 = 0.6666666666666666666666666666666666666666666666666666666666667;
  line += 'H61 ';
endif;
if 2 / 3 > 0.66666666666666666666666666666666666666666666666666666666666666;
  line += 'G62 ';
endif;
if 2 / 3 = 0.66666666666666666666666666666666666666666666666666666666666666;
  line += 'T62 ';
endif;
if 2 / 3 = 0.66666666666666666666666666666666666666666666666666666666666667;
  line += 'H62 ';
endif;
line += '|' + %char(10 / 3) + '|' + %char(2 / 3);
say(line);
*inlr = *on;

dcl-proc say;
  dcl-pi *n;
    text varchar(300) const;
  end-pi;
  dcl-s wbuf varchar(300);
  wbuf = text;
  exec sql call qsys2.ifs_write_utf8(path_name => 'gn1.out', line => :wbuf,
                                     overwrite => 'APPEND', end_of_line => 'LF');
end-proc;
