**FREE
// %CHECK, %CHECKR and %SCANR with a start: inside the string, at its
// length, one past it, 0, and an empty varying field. For an upstream
// fix (the review of PR #9).
ctl-opt dftactgrp(*no);
dcl-s a char(10) inz('AAABBBCCCD');
dcl-s v varchar(10) inz('');
dcl-s n packed(3:0);
dcl-s s0 packed(3:0) inz(0);
dcl-s s1 packed(3:0) inz(1);
dcl-s s2 packed(3:0) inz(2);
dcl-s s5 packed(3:0) inz(5);
dcl-s s9 packed(3:0) inz(9);
dcl-s s10 packed(3:0) inz(10);
dcl-s s11 packed(3:0) inz(11);
monitor;
  n = %check('A':a);
  say('CHECK NOSTART ' + %char(n));
on-error;
  say('CHECK NOSTART ERR ' + %char(%status));
endmon;
monitor;
  n = %check('A':a:s2);
  say('CHECK START2 ' + %char(n));
on-error;
  say('CHECK START2 ERR ' + %char(%status));
endmon;
monitor;
  n = %check('AB':a:s5);
  say('CHECK START5 ' + %char(n));
on-error;
  say('CHECK START5 ERR ' + %char(%status));
endmon;
monitor;
  n = %check('A':a:s10);
  say('CHECK START10 ' + %char(n));
on-error;
  say('CHECK START10 ERR ' + %char(%status));
endmon;
monitor;
  n = %check('A':a:s11);
  say('CHECK START11 ' + %char(n));
on-error;
  say('CHECK START11 ERR ' + %char(%status));
endmon;
monitor;
  n = %check('A':a:s0);
  say('CHECK START0 ' + %char(n));
on-error;
  say('CHECK START0 ERR ' + %char(%status));
endmon;
monitor;
  n = %check('A':v:s1);
  say('CHECK EMPTY1 ' + %char(n));
on-error;
  say('CHECK EMPTY1 ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('CD':a);
  say('CHECKR NOSTART ' + %char(n));
on-error;
  say('CHECKR NOSTART ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('D':a:s9);
  say('CHECKR START9 ' + %char(n));
on-error;
  say('CHECKR START9 ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('CD':a:s5);
  say('CHECKR START5 ' + %char(n));
on-error;
  say('CHECKR START5 ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('A':a:s11);
  say('CHECKR START11 ' + %char(n));
on-error;
  say('CHECKR START11 ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('A':a:s0);
  say('CHECKR START0 ' + %char(n));
on-error;
  say('CHECKR START0 ERR ' + %char(%status));
endmon;
monitor;
  n = %checkr('A':v:s1);
  say('CHECKR EMPTY1 ' + %char(n));
on-error;
  say('CHECKR EMPTY1 ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('B':a);
  say('SCANR NOSTART ' + %char(n));
on-error;
  say('SCANR NOSTART ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('B':a:s5);
  say('SCANR START5 ' + %char(n));
on-error;
  say('SCANR START5 ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('D':a:s10);
  say('SCANR START10 ' + %char(n));
on-error;
  say('SCANR START10 ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('A':a:s11);
  say('SCANR START11 ' + %char(n));
on-error;
  say('SCANR START11 ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('A':a:s0);
  say('SCANR START0 ' + %char(n));
on-error;
  say('SCANR START0 ERR ' + %char(%status));
endmon;
monitor;
  n = %scanr('A':v:s1);
  say('SCANR EMPTY1 ' + %char(n));
on-error;
  say('SCANR EMPTY1 ERR ' + %char(%status));
endmon;
*inlr = *on;
// Write one line to gn1.out in the job's current directory (DSPLY under
// `system` goes to QSYSOPR, a queue PUB400 users share).
dcl-proc say;
  dcl-pi *n;
    text varchar(200) const;
  end-pi;
  dcl-s line varchar(200);
  line = text;
  exec sql call qsys2.ifs_write_utf8(path_name => 'gn1.out', line => :line,
                                     overwrite => 'APPEND', end_of_line => 'LF');
end-proc;
