**FREE
// %SUBST and %SCAN at the edges, for the upstream fix of issue #6: a
// varying field of length 0, a start one past the end with and without
// a length, and %SCAN's start at the length.
ctl-opt dftactgrp(*no);
dcl-s a char(10) inz('ABCDEFGHIJ');
dcl-s v varchar(10) inz('');
dcl-s w varchar(10) inz('AB');
dcl-s c char(5);
dcl-s n packed(3:0);
dcl-s s1 packed(3:0) inz(1);
dcl-s s2 packed(3:0) inz(2);
dcl-s s3 packed(3:0) inz(3);
dcl-s s10 packed(3:0) inz(10);
dcl-s s11 packed(3:0) inz(11);
dcl-s l0 packed(3:0) inz(0);
monitor;
  c = %subst(v:s1:l0);
  say('SUBST EMPTY 1 0 [' + c + ']');
on-error;
  say('SUBST EMPTY 1 0 ERR ' + %char(%status));
endmon;
monitor;
  c = %subst(v:s1);
  say('SUBST EMPTY 1 [' + c + ']');
on-error;
  say('SUBST EMPTY 1 ERR ' + %char(%status));
endmon;
monitor;
  c = %subst(w:s3:l0);
  say('SUBST VAR PAST 0 [' + c + ']');
on-error;
  say('SUBST VAR PAST 0 ERR ' + %char(%status));
endmon;
monitor;
  c = %subst(a:s11);
  say('SUBST PAST NOLEN [' + c + ']');
on-error;
  say('SUBST PAST NOLEN ERR ' + %char(%status));
endmon;
monitor;
  c = %subst(a:s10:l0);
  say('SUBST LAST 0 [' + c + ']');
on-error;
  say('SUBST LAST 0 ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('J':a:s10);
  say('SCAN AT LEN ' + %char(n));
on-error;
  say('SCAN AT LEN ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('A':v);
  say('SCAN EMPTY ' + %char(n));
on-error;
  say('SCAN EMPTY ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('A':v:s1);
  say('SCAN EMPTY START ' + %char(n));
on-error;
  say('SCAN EMPTY START ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('A':v:s2);
  say('SCAN EMPTY START2 ' + %char(n));
on-error;
  say('SCAN EMPTY START2 ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('B':w:s3);
  say('SCAN VAR PAST ' + %char(n));
on-error;
  say('SCAN VAR PAST ERR ' + %char(%status));
endmon;
monitor;
  n = %scan('ABC':w);
  say('SCAN LONGER ' + %char(n));
on-error;
  say('SCAN LONGER ERR ' + %char(%status));
endmon;
*inlr = *on;
*inlr = *on;
// Write one line to gn1.out in the job's current directory (DSPLY under
// `system` goes to QSYSOPR, a queue PUB400 users share).
dcl-proc say;
  dcl-pi *n;
    text varchar(200) const;
  end-pi;
  dcl-s line varchar(200);
  line = text;
  exec sql call qsys2.ifs_write_utf8(path_name => 'gn1.out', line => :line,
                                     overwrite => 'APPEND', end_of_line => 'LF');
end-proc;
