**FREE
// Stage 2, S2.26: %EDITC, lowered to Rust. Expected: what IBM i 7.5 gave
// (golden capture tools/golden/native34.txt n34_editc, cited in
// native_units.rs).
ctl-opt dftactgrp(*no);
dcl-s p packed(9:2) inz(-1234.56);
dcl-s z packed(9:2) inz(0);
dcl-s dt zoned(6:0) inz(31226);
dcl-s i int(10) inz(-1234567);
dcl-s r varchar(40);
r = %editc(p:'1');
dsply ('EDITC 1 NEG [' + r + ']');
r = %editc(p:'2');
dsply ('EDITC 2 NEG [' + r + ']');
r = %editc(p:'3');
dsply ('EDITC 3 NEG [' + r + ']');
r = %editc(p:'4');
dsply ('EDITC 4 NEG [' + r + ']');
r = %editc(p:'A');
dsply ('EDITC A NEG [' + r + ']');
r = %editc(p:'B');
dsply ('EDITC B NEG [' + r + ']');
r = %editc(p:'C');
dsply ('EDITC C NEG [' + r + ']');
r = %editc(p:'D');
dsply ('EDITC D NEG [' + r + ']');
r = %editc(p:'J');
dsply ('EDITC J NEG [' + r + ']');
r = %editc(p:'K');
dsply ('EDITC K NEG [' + r + ']');
r = %editc(p:'L');
dsply ('EDITC L NEG [' + r + ']');
r = %editc(p:'M');
dsply ('EDITC M NEG [' + r + ']');
r = %editc(p:'N');
dsply ('EDITC N NEG [' + r + ']');
r = %editc(p:'O');
dsply ('EDITC O NEG [' + r + ']');
r = %editc(p:'P');
dsply ('EDITC P NEG [' + r + ']');
r = %editc(p:'Q');
dsply ('EDITC Q NEG [' + r + ']');
r = %editc(p:'X');
dsply ('EDITC X NEG [' + r + ']');
r = %editc(p:'Z');
dsply ('EDITC Z NEG [' + r + ']');
r = %editc(z:'1');
dsply ('EDITC 1 ZERO [' + r + ']');
r = %editc(z:'2');
dsply ('EDITC 2 ZERO [' + r + ']');
r = %editc(z:'3');
dsply ('EDITC 3 ZERO [' + r + ']');
r = %editc(z:'4');
dsply ('EDITC 4 ZERO [' + r + ']');
r = %editc(z:'A');
dsply ('EDITC A ZERO [' + r + ']');
r = %editc(z:'B');
dsply ('EDITC B ZERO [' + r + ']');
r = %editc(z:'J');
dsply ('EDITC J ZERO [' + r + ']');
r = %editc(z:'K');
dsply ('EDITC K ZERO [' + r + ']');
r = %editc(z:'N');
dsply ('EDITC N ZERO [' + r + ']');
r = %editc(z:'O');
dsply ('EDITC O ZERO [' + r + ']');
r = %editc(z:'Z');
dsply ('EDITC Z ZERO [' + r + ']');
r = %editc(dt:'Y');
dsply ('EDITC Y DATE [' + r + ']');
r = %editc(12345:'3');
dsply ('EDITC LIT [' + r + ']');
r = %editc(p * 2:'J');
dsply ('EDITC EXPR [' + r + ']');
r = %editc(i:'1');
dsply ('EDITC INT [' + r + ']');
*inlr = *on;
