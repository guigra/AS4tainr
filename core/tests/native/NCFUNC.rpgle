**FREE
// Stage 2, S2.56: C runtime functions and a CEE API, lowered to Rust.
// Expected: what IBM i 7.5 gave (golden capture tools/golden/native57.txt
// n57_c, cited in native_units.rs).
ctl-opt dftactgrp(*no) bnddir('QC2LE');
dcl-pr strlen int(10) extproc('strlen');
  s pointer value;
end-pr;
dcl-pr toupper int(10) extproc('toupper');
  c int(10) value;
end-pr;
dcl-pr isdigit int(10) extproc('isdigit');
  c int(10) value;
end-pr;
dcl-pr memset pointer extproc('memset');
  p pointer value;
  c int(10) value;
  n uns(10) value;
end-pr;
dcl-pr memcpy pointer extproc('memcpy');
  d pointer value;
  s pointer value;
  n uns(10) value;
end-pr;
dcl-pr strcmp int(10) extproc('strcmp');
  a pointer value;
  b pointer value;
end-pr;
dcl-pr atoi int(10) extproc('atoi');
  s pointer value;
end-pr;
dcl-pr ceedywk extproc('CEEDYWK');
  lilian int(10) const;
  wkday int(10);
  fc char(12);
end-pr;
dcl-s buf char(12) inz('hello');
dcl-s buf2 char(12);
dcl-s num char(6);
dcl-s n int(10);
dcl-s wd int(10);
dcl-s fc char(12);
%subst(buf : 6 : 1) = x'00';
n = strlen(%addr(buf));
dsply ('STRLEN ' + %char(n));
n = toupper(97);
dsply ('TOUPPER ' + %char(n));
if isdigit(55) <> 0;
  dsply ('ISDIGIT 7 YES');
endif;
if isdigit(65) = 0;
  dsply ('ISDIGIT A NO');
endif;
memset(%addr(buf2) : 64 : %size(buf2));
memcpy(%addr(buf2) : %addr(buf) : 6);
dsply ('MEMCPY [' + %subst(buf2 : 1 : 5) + ']');
n = strcmp(%addr(buf) : %addr(buf2));
dsply ('STRCMP ' + %char(n));
num = '123' + x'00';
n = atoi(%addr(num));
dsply ('ATOI ' + %char(n));
ceedywk(162201 : wd : fc);
dsply ('CEEDYWK ' + %char(wd));
*inlr = *on;
