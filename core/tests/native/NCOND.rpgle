**FREE
// Stage 2, S2.13: conditions with built-in functions and concatenation
// on either side, lowered to Rust. Expected: what IBM i 7.5 gave (golden
// capture tools/golden/native11.txt n11_cond, cited in native_units.rs).
ctl-opt dftactgrp(*no);
dcl-s a char(10) inz('ABCDEFGHIJ');
dcl-s b char(6) inz('  XY  ');
if %scan('C':a) > 0;
  dsply ('SCAN COND YES');
else;
  dsply ('SCAN COND NO');
endif;
if %scan('Q':a) = 0;
  dsply ('SCAN COND NONE');
else;
  dsply ('SCAN COND FOUND');
endif;
if %subst(a:2:3) = 'BCD';
  dsply ('SUBST COND EQ');
else;
  dsply ('SUBST COND NE');
endif;
if %trim(b) = 'XY';
  dsply ('TRIM COND EQ');
else;
  dsply ('TRIM COND NE');
endif;
if %trim(b) + 'Z' = 'XYZ';
  dsply ('CAT COND EQ');
else;
  dsply ('CAT COND NE');
endif;
if %triml(b) = 'XY';
  dsply ('TRIML COND PADDED EQ');
else;
  dsply ('TRIML COND PADDED NE');
endif;
if %scan('C':a) > 2 and %trim(b) <> '';
  dsply ('AND COND YES');
else;
  dsply ('AND COND NO');
endif;
if %scan('Z':a) > 0 or %subst(a:1:1) = 'A';
  dsply ('OR COND YES');
else;
  dsply ('OR COND NO');
endif;
if %len(a) = 10;
  dsply ('LEN COND YES');
else;
  dsply ('LEN COND NO');
endif;
if %xlate('AB':'ab':a) = 'abCDEFGHIJ';
  dsply ('XLATE COND EQ');
else;
  dsply ('XLATE COND NE');
endif;
if %subst(a:1:3) < 'ABD';
  dsply ('SUBST COND LT');
else;
  dsply ('SUBST COND GE');
endif;
*inlr = *on;
